# Tarayicida calisan kodun API adresi.
# DIKKAT: NEXT_PUBLIC_* degerleri build sirasinda bundle'a gomulur ve
# tarayicidan okunabilir — SECRET DEGILDIR, secret koymayin.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Sunucu tarafi (SSR / route handler) isteklerinin gittigi adres.
# Yalnizca Docker/compose ortaminda gerekir; bos birakilirsa
# NEXT_PUBLIC_API_URL kullanilir.
# Ornek (compose ici): http://api:4000
INTERNAL_API_URL=""
